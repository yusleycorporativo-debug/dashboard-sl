#SLH .AN{font-size:11px;color:var(--mu2)}
#SLH .AK{font-size:11px;display:flex;gap:8px;flex-wrap:wrap;color:var(--mu)}
#SLH .CpB{display:flex;gap:6px;margin-top:9px;padding-top:8px;border-top:1px solid var(--b1)}
/* CHARTS */
#SLH .ChG{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
#SLH .Ch{background:var(--c1);border:1px solid var(--b1);border-radius:12px;padding:15px}
#SLH .Ch h4{font-size:13px;font-weight:600;margin-bottom:3px;color:var(--tx)}
#SLH .Ch p{font-size:11px;color:var(--mu2);margin-bottom:12px}
