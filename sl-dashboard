    var data=ser.map(function(srx){return MES.map(function(mm){return cs.filter(function(x){return x.canal===srx[0]}).reduce(function(a,x){return a+sum(x.inv,mm)},0)})});
    var mx=1;data.forEach(function(d){d.forEach(function(v){if(v>mx)mx=v})});mx*=1.18;
    var g=r.g,W=r.W,H=r.H,P={t:16,r:12,b:26,l:46},cW=W-P.l-P.r,cH=H-P.t-P.b;g.clearRect(0,0,W,H);
    for(var i=0;i<=4;i++){var y=P.t+i/4*cH;g.strokeStyle='rgba(255,255,255,.05)';g.beginPath();g.moveTo(P.l,y);g.lineTo(W-P.r,y);g.stroke();g.fillStyle='rgba(255,255,255,.28)';g.font='10px sans-serif';g.textAlign='right';g.fillText('$'+Math.round(mx*(1-i/4)/1000)+'k',P.l-4,y+3)}
    var gw=cW/MES.length,bw=Math.max(gw*.2,3);
    for(var j=0;j<MES.length;j++){for(var sx=0;sx<3;sx++){var v=data[sx][j],h=v/mx*cH,x=P.l+j*gw+gw/2-(bw*3+6)/2+sx*(bw+3);g.fillStyle=ser[sx][1];g.fillRect(x,P.t+cH-h,bw,h)}g.fillStyle='rgba(255,255,255,.35)';g.font='10px sans-serif';g.textAlign='center';g.fillText(MES[j].slice(0,3),P.l+j*gw+gw/2,H-6)}
  }
  var r2=ctx('ch2');
  if(r2){
    var vals=MES.map(function(mm){return cs.reduce(function(a,c){return a+sum(c.res,mm)},0)});
    var mx2=1;vals.forEach(function(v){if(v>mx2)mx2=v});mx2*=1.15;
    var g=r2.g,W=r2.W,H=r2.H,P={t:18,r:14,b:26,l:48},cW=W-P.l-P.r,cH=H-P.t-P.b;g.clearRect(0,0,W,H);
    function xf(i){return MES.length<2?P.l+cW/2:P.l+i/(MES.length-1)*cW}function yf(v){return P.t+cH-v/mx2*cH}
    for(var i=0;i<=4;i++){var y=P.t+i/4*cH;g.strokeStyle='rgba(255,255,255,.05)';g.beginPath();g.moveTo(P.l,y);g.lineTo(W-P.r,y);g.stroke();g.fillStyle='rgba(255,255,255,.28)';g.font='10px sans-serif';g.textAlign='right';g.fillText(Math.round(mx2*(1-i/4)),P.l-4,y+3)}
    var gr=g.createLinearGradient(0,P.t,0,P.t+cH);gr.addColorStop(0,'rgba(0,200,150,.32)');gr.addColorStop(1,'rgba(0,200,150,0)');
    g.beginPath();vals.forEach(function(v,i){i?g.lineTo(xf(i),yf(v)):g.moveTo(xf(i),yf(v))});g.lineTo(xf(MES.length-1),P.t+cH);g.lineTo(xf(0),P.t+cH);g.closePath();g.fillStyle=gr;g.fill();
    g.strokeStyle='#00c896';g.lineWidth=2.4;g.beginPath();vals.forEach(function(v,i){i?g.lineTo(xf(i),yf(v)):g.moveTo(xf(i),yf(v))});g.stroke();
