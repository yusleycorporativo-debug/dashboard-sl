var MORD=['ENERO','FEBRERO','MARZO','ABRIL','MAYO','JUNIO','JULIO','AGOSTO','SEPTIEMBRE','OCTUBRE','NOVIEMBRE','DICIEMBRE'];
function monthsWith(cs){var h={};cs.forEach(function(c){['inv','res','imp'].forEach(function(k){var o=c[k]||{};for(var mm in o)if(+o[mm])h[mm]=1})});var r=[];for(var i=0;i<MORD.length;i++)if(h[MORD[i]])r.push(MORD[i]);return r.length?r:MORD.slice(0,6)}
function ctx(id){var c=$(id);if(!c)return null;c.width=c.offsetWidth||320;return{c:c,g:c.getContext('2d'),W:c.width,H:c.height}}
function trendLine(id,vals,labels,col,fmt){var r=ctx(id);if(!r)return;var g=r.g,W=r.W,H=r.H,P={t:18,r:14,b:24,l:50},cW=W-P.l-P.r,cH=H-P.t-P.b;g.clearRect(0,0,W,H);var mx=1;vals.forEach(function(v){if(v>mx)mx=v});mx=(mx*1.2)||1;var n=vals.length;function xf(i){return n<2?P.l+cW/2:P.l+i/(n-1)*cW}function yf(v){return P.t+cH-v/mx*cH}for(var i=0;i<=4;i++){var y=P.t+i/4*cH;g.strokeStyle='rgba(255,255,255,.05)';g.beginPath();g.moveTo(P.l,y);g.lineTo(W-P.r,y);g.stroke();g.fillStyle='rgba(255,255,255,.28)';g.font='10px sans-serif';g.textAlign='right';g.fillText(fmt(mx*(1-i/4)),P.l-4,y+3)}g.strokeStyle=col;g.lineWidth=2.2;g.beginPath();vals.forEach(function(v,i){i?g.lineTo(xf(i),yf(v)):g.moveTo(xf(i),yf(v))});g.stroke();vals.forEach(function(v,i){g.beginPath();g.arc(xf(i),yf(v),3.5,0,7);g.fillStyle=col;g.fill();g.strokeStyle='#070709';g.lineWidth=2;g.stroke();g.fillStyle='rgba(255,255,255,.34)';g.font='10px sans-serif';g.textAlign='center';g.fillText(labels[i].slice(0,3),xf(i),H-5);if(v>0){g.fillStyle='rgba(255,255,255,.62)';g.fillText(fmt(v),xf(i),yf(v)-8)}});}
function drawCharts(){
