window.cfgAdd=function(k){var inp2=$('cfginp-'+k);var v=inp2?inp2.value.trim():'';if(!v)return;var list=CAT(k);if(list.includes(v)){T('Ya existe',true);return}list.push(v);localStorage.setItem('sl_cfg_'+k,JSON.stringify(list));if(inp2)inp2.value='';rCfgCard(k);T('"'+v+'" agregado')};
window.cfgDel=function(k,idx){var list=CAT(k);if(!confirm('Eliminar "'+list[idx]+'"?'))return;list.splice(idx,1);localStorage.setItem('sl_cfg_'+k,JSON.stringify(list));rCfgCard(k);T('Eliminado')};
function rCfgCard(k){var items=CAT(k);var tg=$('cfgtg-'+k),cn=$('cfgcnt-'+k);if(cn)cn.textContent=items.length;if(!tg)return;var colMap={responsables:'#00c896',marcas:'#a29bfe',canales:'#0097e6',nichos:'#ffc43e',categorias:'#fd79a8',plataformas:'#00c896'};var c=colMap[k]||'#00c896';tg.innerHTML=items.map(function(v,i){return'<span style="display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:20px;font-size:12px;background:'+c+'18;color:'+c+';border:1px solid '+c+'28">'+v+'<button onclick="cfgDel(\''+k+'\','+i+')" style="background:none;border:none;color:'+c+';cursor:pointer;font-size:13px;padding:0;line-height:1;opacity:.6">x</button></span>'}).join('')}
window.cfgBulk=function(){var k=val('cfg-dest'),mode=val('cfg-modo'),raw=val('cfg-bulk');if(!raw){T('Pega los valores',true);return}var vals=raw.split(/[\n,]+/).map(function(v){return v.trim()}).filter(Boolean);var current=mode==='replace'?[]:CAT(k);var merged=Array.from(new Set(current.concat(vals)));localStorage.setItem('sl_cfg_'+k,JSON.stringify(merged));var e=$('cfg-bulk');if(e)e.value='';rCfgCard(k);T(vals.length+' elementos aplicados')};
