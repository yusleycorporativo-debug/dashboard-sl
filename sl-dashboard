#SLH .SS{font-size:9.5px;letter-spacing:2px;text-transform:uppercase;color:var(--mu);padding:16px 20px 6px;display:block}
#SLH .SI{display:flex;align-items:center;gap:11px;padding:10px 20px;font-size:13.5px;color:var(--mu2);
  cursor:pointer;border:none;border-left:3px solid transparent;background:transparent;width:100%;
  text-align:left;font-family:inherit;transition:.13s}
#SLH .SI:hover{color:var(--tx);background:rgba(255,255,255,.035)}
#SLH .SI.on{color:var(--ac);background:linear-gradient(90deg,rgba(0,200,150,.12),transparent);border-left-color:var(--ac)}
#SLH .SI .ic{width:20px;text-align:center;font-size:15px;flex-shrink:0}
#SLH .OV{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:490}
#SLH .MN{flex:1;min-width:0;padding:22px}
/* TITLES */
#SLH .PgT{font-size:22px;font-weight:800;letter-spacing:-.6px;margin-bottom:3px}
#SLH .PgS{font-size:12.5px;color:var(--mu2);margin-bottom:20px}
#SLH .ST{font-size:9.5px;letter-spacing:2.2px;text-transform:uppercase;color:var(--mu);
  margin:24px 0 13px;display:flex;align-items:center;gap:10px}
#SLH .ST::after{content:'';flex:1;height:1px;background:var(--line)}
/* FILTER BAR */
#SLH .FB{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:11px 13px;
  margin-bottom:18px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
#SLH .Fi,#SLH .Fs{background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:9px;
  color:var(--tx);padding:7px 11px;font-size:13px;font-family:inherit}
#SLH .Fi:focus,#SLH .Fs:focus{outline:none;border-color:var(--ac);box-shadow:0 0 0 3px rgba(0,200,150,.12)}
#SLH .Fi::placeholder{color:var(--mu)}
#SLH .Fs option{background:#15151c;color:var(--tx)}
#SLH .FSp{flex:1}
/* BUTTONS */
#SLH .btn{padding:8px 14px;border-radius:9px;font-size:12.5px;font-weight:700;cursor:pointer;
  border:1px solid;font-family:inherit;transition:.13s}
#SLH .bg{background:rgba(0,200,150,.13);color:var(--ac);border-color:rgba(0,200,150,.3)}
#SLH .bg:hover{background:rgba(0,200,150,.22)}
#SLH .bb{background:rgba(0,151,230,.12);color:var(--ac2);border-color:rgba(0,151,230,.28)}
#SLH .bb:hover{background:rgba(0,151,230,.2)}
#SLH .bw{background:rgba(255,196,62,.12);color:var(--wn);border-color:rgba(255,196,62,.28)}
#SLH .br{background:rgba(255,77,103,.1);color:var(--dg);border-color:rgba(255,77,103,.25)}
#SLH .bgh{background:transparent;color:var(--mu2);border-color:var(--line)}
#SLH .bgh:hover{color:var(--tx);border-color:var(--line2)}
#SLH .sm{font-size:11px;padding:6px 11px}
/* CARD / GRIDS */
#SLH .Cd{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:18px;margin-bottom:14px}
#SLH .Cd h3{font-size:14px;font-weight:700;margin-bottom:14px}
#SLH .G2{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:11px}
#SLH .G4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px}
#SLH .FG{display:flex;flex-direction:column;gap:5px;margin-bottom:2px}
#SLH .FG label{font-size:11px;color:var(--mu2)}
#SLH .FG .Fi,#SLH .FG .Fs{width:100%}
#SLH .FG textarea.Fi{resize:vertical;min-height:62px}
/* KPI */
#SLH .KG{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:11px;margin-bottom:14px}
#SLH .KC{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:15px;position:relative;overflow:hidden}
#SLH .KC::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--bar,var(--ac))}
#SLH .KL{font-size:10px;letter-spacing:.5px;text-transform:uppercase;color:var(--mu2);display:block;margin-bottom:8px}
#SLH .KV{font-size:23px;font-weight:800;line-height:1;font-family:var(--num);letter-spacing:-.5px}
#SLH .KT{font-size:10.5px;margin-top:5px;font-weight:600}
/* CANAL */
#SLH .CaG{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:11px;margin-bottom:14px}
#SLH .CaC{background:var(--card);border:1px solid var(--line);border-radius:15px;padding:15px}
#SLH .CaN{font-size:10px;letter-spacing:1px;text-transform:uppercase;font-weight:700;margin-bottom:7px}
#SLH .CaV{font-size:22px;font-weight:800;font-family:var(--num);margin-bottom:4px}
#SLH .CaS{font-size:11px;color:var(--mu2)}
/* BUDGET */
#SLH .BC{background:linear-gradient(135deg,rgba(0,200,150,.07),var(--card));border:1px solid var(--line);
  border-left:3px solid var(--ac);border-radius:16px;padding:18px;margin-bottom:14px}
#SLH .BL{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ac);margin-bottom:13px;display:block;font-weight:700}
#SLH .BG{display:grid;grid-template-columns:repeat(auto-fit,minmax(118px,1fr));gap:12px;margin-bottom:14px}
#SLH .BI label{font-size:10px;color:var(--mu2);display:block;margin-bottom:4px}
#SLH .BV{font-size:22px;font-weight:800;font-family:var(--num);cursor:pointer;background:none;border:none;color:var(--tx);padding:0}
#SLH .BV:hover{opacity:.75}
#SLH .PW{display:flex;align-items:center;gap:10px}
#SLH .PB{flex:1;height:6px;background:rgba(255,255,255,.07);border-radius:4px;overflow:hidden}
#SLH .PF{height:100%;border-radius:4px;transition:width .4s}
#SLH .PP{font-size:12px;color:var(--mu2);min-width:90px;text-align:right;font-family:var(--num)}
/* TABLE */
#SLH .TC{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;margin-bottom:14px}
#SLH .TH{padding:12px 16px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
#SLH .TH h3{font-size:13px;font-weight:700}
#SLH .TS{overflow-x:auto}
#SLH table{width:100%;border-collapse:collapse}
#SLH th{font-size:10px;letter-spacing:.6px;text-transform:uppercase;color:var(--mu2);padding:10px 13px;
  text-align:left;background:rgba(255,255,255,.02);border-bottom:1px solid var(--line);white-space:nowrap}
#SLH td{padding:10px 13px;font-size:12.5px;border-bottom:1px solid var(--line);vertical-align:middle}
#SLH tr:last-child td{border-bottom:none}
#SLH tbody tr:hover td{background:rgba(255,255,255,.022)}
#SLH .mono{font-family:var(--num)}
/* PILLS */
#SLH .pl{display:inline-flex;align-items:center;padding:3px 10px;border-radius:20px;font-size:11px;font-weight:700}
#SLH .pa{background:rgba(0,200,150,.14);color:var(--ac)}
#SLH .pi{background:rgba(130,130,130,.16);color:#9a9aa8}
#SLH .pb{background:rgba(0,151,230,.14);color:var(--ac2)}
#SLH .pp{background:rgba(167,139,250,.14);color:var(--pu)}
#SLH .pw{background:rgba(255,196,62,.14);color:var(--wn)}
#SLH .pr{background:rgba(255,77,103,.14);color:var(--dg)}
/* CHARTS */
#SLH .ChG{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px}
#SLH .Ch{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px}
#SLH .Ch h4{font-size:13px;font-weight:700;margin-bottom:2px}
#SLH .Ch p{font-size:11px;color:var(--mu2);margin-bottom:12px}
/* TABS */
#SLH .TB{display:flex;gap:4px;background:var(--card);border:1px solid var(--line);border-radius:13px;padding:5px;margin-bottom:16px;flex-wrap:wrap}
#SLH .TBb{flex:1;min-width:90px;padding:9px;text-align:center;font-size:12.5px;font-weight:700;border-radius:9px;
  cursor:pointer;color:var(--mu2);border:none;background:transparent;font-family:inherit;transition:.13s}
#SLH .TBb:hover{color:var(--tx);background:rgba(255,255,255,.04)}
#SLH .TBb.on{background:rgba(0,200,150,.13);color:var(--ac)}
/* MODAL */
#SLH .Mb{display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:800;align-items:center;justify-content:center;padding:16px}
#SLH .Mb.on{display:flex}
#SLH .Md{background:#101015;border:1px solid var(--line2);border-radius:18px;padding:22px;max-width:640px;width:100%;max-height:90vh;overflow-y:auto}
#SLH .Md h3{font-size:16px;font-weight:800;margin-bottom:16px}
#SLH .Mbt{display:flex;gap:9px;margin-top:18px;padding-top:15px;border-top:1px solid var(--line)}
/* LOG */
#SLH .LI{padding:11px 16px;border-bottom:1px solid var(--line);display:flex;gap:11px;align-items:flex-start}
#SLH .LI:last-child{border-bottom:none}
#SLH .LD{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:4px}
#SLH .LF{font-size:11px;color:var(--mu);min-width:140px;flex-shrink:0;font-family:var(--num)}
#SLH .LA{font-size:13px;font-weight:700}
#SLH .LB{font-size:11.5px;color:var(--mu2)}
/* TOAST */
#SLHt{position:fixed;bottom:20px;right:20px;background:#15151c;border:1px solid rgba(0,200,150,.35);
  border-radius:11px;padding:11px 18px;color:var(--ac);font-size:13px;font-weight:600;
  opacity:0;transform:translateY(8px);transition:.25s;z-index:9999;pointer-events:none;box-shadow:0 8px 30px rgba(0,0,0,.5)}
#SLHt.on{opacity:1;transform:none}
/* chips */
#SLH .chip{display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,.05);border:1px solid var(--line);
  border-radius:8px;padding:4px 10px;font-size:12px;margin:3px}
#SLH .chip b{cursor:pointer;color:var(--dg);font-weight:800}
/* MOBILE */
@media(max-width:820px){
  #SLH .SB{position:fixed;left:-240px;top:58px;height:calc(100vh - 58px);z-index:495;transition:left .22s}
  #SLH .SB.open{left:0}
  #SLH .OV.on{display:block}
  #SLH .HBg{display:block}
  #SLH .MN{padding:13px}
  #SLH .ChG,#SLH .G2,#SLH .G4{grid-template-columns:1fr}
}

/* nesting / best / lock / print v6 */
#SLH .tgl{cursor:pointer;color:var(--mu2);user-select:none;display:inline-block;width:14px}
#SLH .childR td{background:rgba(255,255,255,.02)!important;font-size:11.5px}
#SLH .childR2 td{background:rgba(0,151,230,.045)!important;font-size:11px}
#SLH .ind1{padding-left:26px!important}
#SLH .ind2{padding-left:46px!important}
#SLH .star{cursor:pointer;font-size:15px;color:var(--mu);background:none;border:none;padding:0 2px}
#SLH .star.on{color:var(--wn)}
#SLH tr.best td:first-child{box-shadow:inset 3px 0 0 var(--wn)}
#SLH .lk{display:flex;align-items:center;gap:6px;background:var(--card);border:1px solid var(--line);border-radius:20px;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer;color:var(--mu2)}
#SLH .lk.open{color:var(--ac);border-color:rgba(0,200,150,.35)}
#SLH.locked .edl{opacity:.35;pointer-events:none}
#SLH.locked .edl input,#SLH.locked .edl textarea,#SLH.locked .edl select,#SLH.locked .edl button{pointer-events:none}
@media print{
  body *{visibility:hidden}
  #SLH,#SLH *{visibility:visible}
  #SLH{position:absolute;left:0;top:0;width:100%;background:#fff!important;color:#111!important;background-image:none!important}
  #SLH .H,#SLH .SB,#SLH .OV,#SLH .HBg,#SLH .lk,#SLH .FB .btn,#SLH .edl,#SLH .Mb,#SLHt,#SLH .TBb:not(.on),#SLH [data-go],#SLH .FB .Fs,#SLH .FB .Fi{display:none!important}
  #SLH .MN{padding:0!important}
  #SLH .Cd,#SLH .KC,#SLH .CaC,#SLH .TC,#SLH .Ch,#SLH .BC{background:#fff!important;border:1px solid #bbb!important;color:#111!important;box-shadow:none!important;break-inside:avoid;page-break-inside:avoid}
  #SLH .KV,#SLH .CaV,#SLH .BV,#SLH .PgT,#SLH .PgS,#SLH td,#SLH th,#SLH h3,#SLH h4,#SLH .LA,#SLH .KL,#SLH .CaN,#SLH .CaS{color:#111!important}
  #SLH th{background:#eee!important}
  #SLH .pl{border:1px solid #999;color:#111!important}
  #SLH .ChG,#SLH .G2,#SLH .G4{display:block!important}
  #SLH canvas{max-width:100%!important;filter:invert(.9) hue-rotate(180deg)}
  #SLH .ST{color:#444!important}
}

/* parrilla contenido / email */
#SLH .calgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
#SLH .calh{font-size:9.5px;letter-spacing:1px;text-transform:uppercase;color:var(--mu);text-align:center;padding:3px}
#SLH .calc{min-height:78px;background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:8px;padding:5px}
#SLH .calc.out{opacity:.3}
#SLH .calc.today{border-color:var(--ac)}
#SLH .cald{font-size:11px;color:var(--mu2);font-family:var(--num);margin-bottom:4px}
#SLH .cchip{display:block;font-size:9.5px;line-height:1.3;padding:3px 6px;border-radius:5px;margin-bottom:3px;color:#06120e;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;cursor:pointer}
#SLH .emgrid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
#SLH .emcol{background:rgba(255,255,255,.02);border:1px solid var(--line);border-radius:9px;padding:7px;min-height:64px}
#SLH .emcol h5{font-size:10px;text-transform:uppercase;letter-spacing:1px;color:var(--mu2);margin:0 0 6px;text-align:center;font-weight:700}
#SLH .emchip{display:block;font-size:9.5px;padding:3px 6px;border-radius:5px;margin-bottom:4px;color:#06120e;font-weight:700;cursor:pointer;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media(max-width:820px){#SLH .calgrid,#SLH .emgrid{grid-template-columns:repeat(7,minmax(74px,1fr));overflow-x:auto}}
</style>

