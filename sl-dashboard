function rStorage(){var keys={campaigns:'Campanas',adsets:'Conjuntos',ads:'Anuncios',objectives:'Objetivos',budget_history:'Presupuesto',actividades:'Actividades',pendientes:'Pendientes',observaciones:'Observaciones',logs:'Bitacora'};set('dt-storage',Object.entries(keys).map(function(e){var d=G(e[0])||[];return'<div class="KC" style="text-align:center"><div class="KV" style="color:var(--ac)">'+d.length+'</div><span class="KL">'+e[1]+'</span></div>'}).join(''))}
window.impCSV=function(input){var file=input.files[0];if(!file)return;var reader=new FileReader();reader.onload=function(e){var sep=e.target.result.includes(';')?';':',';var lines=e.target.result.trim().split('\n');if(lines.length<2){T('CSV vacio',true);return}var hdrs=lines[0].split(sep).map(function(h){return h.replace(/"/g,'').trim()});var rows=lines.slice(1).map(function(line){var vals=[],cur='',inQ=false;for(var i=0;i<line.length;i++){var c=line[i];if(c==='"'){inQ=!inQ}else if(c===sep&&!inQ){vals.push(cur.trim());cur=''}else cur+=c}vals.push(cur.trim());var obj={};hdrs.forEach(function(h,i){obj[h]=vals[i]||''});return obj});var prev=$('imp-prev');if(prev){prev.style.display='block';prev.innerHTML='<strong style="color:var(--ac)">'+rows.length+' filas detectadas</strong><br><br>Columnas: '+hdrs.slice(0,6).join(', ')+'<br><br><button class="btn bg" onclick="confirmImp()">Confirmar importacion</button> <button class="btn bgh" onclick="document.getElementById(\'imp-prev\').style.display=\'none\'">Cancelar</button>'}window._pendImp=rows};reader.readAsText(file,'utf-8')};
window.confirmImp=function(){var d=window._pendImp;if(!d)return;var camps=G('campaigns')||[];var added=0;d.forEach(function(r){var n=r['Nombre de la campana']||r['Campaign Name']||'';if(!n)return;if(camps.find(function(c){return c.n===n}))return;var inv=parseFloat(r['Importe gastado (MXN)']||r['Amount Spent (MXN)'])||0;camps.push({id:'imp'+Date.now()+added,n:n,canal:'Meta Ads',marca:'SuperLabs Nutrition',seg:'B2B – Mayoreo',obj:r['Indicador de resultado']||'—',est:'Inactiva',pres:200,inv:{IMPORTADO:inv},res:{IMPORTADO:parseFloat(r['Resultados']||r['Results'])||0},imp:{IMPORTADO:parseFloat(r['Impresiones']||r['Impressions'])||0},alc:{},cli:{},tipo:'Import',per:'Import'});added++});S('campaigns',camps);LOG('IMPORT CSV',added+' campanas nuevas');T(added+' campanas importadas');var p=$('imp-prev');if(p)p.style.display='none';window._pendImp=null;rStorage()};
window.impJSON=function(input){var file=input.files[0];if(!file)return;if(!confirm('Importar JSON? Reemplazara datos existentes.'))return;var reader=new FileReader();reader.onload=function(e){try{var d=JSON.parse(e.target.result);['campaigns','adsets','ads','objectives','budget_history','actividades','pendientes','observaciones','logs'].forEach(function(k){if(d[k])S(k,d[k])});LOG('IMPORT JSON',file.name);T('Sistema restaurado');rStorage()}catch(ex){T('Error en el JSON',true)}};reader.readAsText(file)};
