  }
  var r3=ctx('ch3');
  if(r3){
    var fc3=fCamps(cs,fGet());
    var cpc=MES.map(function(mm){var iv=0,cl=0;fc3.forEach(function(c){iv+=sum(c.inv,mm);cl+=sum(c.cli,mm)});return cl>0?iv/cl:0});
    var mx3=1;cpc.forEach(function(v){if(v>mx3)mx3=v});mx3=(mx3*1.2)||1;
    var g=r3.g,W=r3.W,H=r3.H,P={t:18,r:14,b:26,l:50},cW=W-P.l-P.r,cH=H-P.t-P.b;g.clearRect(0,0,W,H);
    function xf(i){return MES.length<2?P.l+cW/2:P.l+i/(MES.length-1)*cW}function yf(v){return P.t+cH-v/mx3*cH}
    for(var i=0;i<=4;i++){var y=P.t+i/4*cH;g.strokeStyle='rgba(255,255,255,.05)';g.beginPath();g.moveTo(P.l,y);g.lineTo(W-P.r,y);g.stroke();g.fillStyle='rgba(255,255,255,.28)';g.font='10px sans-serif';g.textAlign='right';g.fillText('$'+(mx3*(1-i/4)).toFixed(1),P.l-4,y+3)}
    var gr=g.createLinearGradient(0,P.t,0,P.t+cH);gr.addColorStop(0,'rgba(0,151,230,.28)');gr.addColorStop(1,'rgba(0,151,230,0)');
    g.beginPath();cpc.forEach(function(v,i){i?g.lineTo(xf(i),yf(v)):g.moveTo(xf(i),yf(v))});g.lineTo(xf(MES.length-1),P.t+cH);g.lineTo(xf(0),P.t+cH);g.closePath();g.fillStyle=gr;g.fill();
    g.strokeStyle='#0097e6';g.lineWidth=2.4;g.beginPath();cpc.forEach(function(v,i){i?g.lineTo(xf(i),yf(v)):g.moveTo(xf(i),yf(v))});g.stroke();
    cpc.forEach(function(v,i){g.beginPath();g.arc(xf(i),yf(v),4,0,7);g.fillStyle='#0097e6';g.fill();g.strokeStyle='#070709';g.lineWidth=2;g.stroke();g.fillStyle='rgba(255,255,255,.34)';g.font='10px sans-serif';g.textAlign='center';g.fillText(MES[i].slice(0,3),xf(i),H-6);if(v>0){g.fillStyle='rgba(255,255,255,.7)';g.fillText('$'+v.toFixed(1),xf(i),yf(v)-9)}});
  }
  var fcT=fCamps(cs,fGet());
