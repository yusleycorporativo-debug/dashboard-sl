window._render_datos=function(){
  set('imp-cards','<label style="background:var(--c1);border:1px solid var(--b1);border-radius:12px;padding:16px;text-align:center;cursor:pointer;transition:border-color .12s;display:block" onmouseover="this.style.borderColor=\'var(--ac)\'" onmouseout="this.style.borderColor=\'var(--b1)\'"><div style="font-size:28px;margin-bottom:8px">&#128226;</div><div style="font-size:13px;font-weight:600;margin-bottom:4px">CSV Campanas</div><div style="font-size:11px;color:var(--mu2)">Meta Ads Manager</div><input type="file" accept=".csv" style="display:none" onchange="impCSV(this)"></label><label style="background:var(--c1);border:1px solid var(--b1);border-radius:12px;padding:16px;text-align:center;cursor:pointer;transition:border-color .12s;display:block" onmouseover="this.style.borderColor=\'var(--ac)\'" onmouseout="this.style.borderColor=\'var(--b1)\'"><div style="font-size:28px;margin-bottom:8px">&#128260;</div><div style="font-size:13px;font-weight:600;margin-bottom:4px">Restaurar JSON</div><div style="font-size:11px;color:var(--mu2)">Respaldo completo</div><input type="file" accept=".json" style="display:none" onchange="impJSON(this)"></label>');
  rStorage();
