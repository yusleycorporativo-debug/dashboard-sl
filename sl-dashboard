#SLH .Mbt{display:flex;gap:8px;margin-top:16px;padding-top:14px;border-top:1px solid var(--b1)}
/* LOG */
#SLH .LI{padding:9px 15px;border-bottom:1px solid var(--b1);display:flex;align-items:flex-start;gap:10px}
