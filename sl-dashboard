window.clrAll=function(){if(!confirm('Eliminar TODOS los datos?'))return;if(!confirm('Segunda confirmacion: estas segura?'))return;['campaigns','adsets','ads','objectives','budget_history','actividades','pendientes','observaciones','logs'].forEach(function(k){localStorage.removeItem('sl_'+k)});T('Datos limpiados. Recarga la pagina.')};

