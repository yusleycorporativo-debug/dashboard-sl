window._render_configuracion=function(){
  var CATS={responsables:{l:'Responsables',c:'#00c896'},marcas:{l:'Marcas',c:'#a29bfe'},canales:{l:'Canales',c:'#0097e6'},nichos:{l:'Nichos mayoreo',c:'#ffc43e'},categorias:{l:'Categorias actividad',c:'#fd79a8'},plataformas:{l:'Plataformas',c:'#00c896'}};
  var html='';
  Object.entries(CATS).forEach(function(e){var k=e[0],m=e[1];var items=CAT(k);html+='<div style="background:var(--c1);border:1px solid var(--b1);border-radius:12px;overflow:hidden"><div style="padding:10px 14px;border-bottom:1px solid var(--b1);background:rgba(255,255,255,.02);display:flex;align-items:center;justify-content:space-between"><div style="font-size:13px;font-weight:600">'+m.l+'</div><span id="cfgcnt-'+k+'" style="font-size:10px;padding:2px 8px;background:rgba(255,255,255,.06);border-radius:10px;color:var(--mu2)">'+items.length+'</span></div><div style="padding:10px 14px"><div id="cfgtg-'+k+'" style="display:flex;flex-wrap:wrap;gap:5px;min-height:28px;margin-bottom:8px">'+items.map(function(v,i){return'<span style="display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:20px;font-size:12px;background:'+m.c+'18;color:'+m.c+';border:1px solid '+m.c+'28">'+v+'<button onclick="cfgDel(\''+k+'\','+i+')" style="background:none;border:none;color:'+m.c+';cursor:pointer;font-size:13px;padding:0;line-height:1;opacity:.6">x</button></span>'}).join('')+'</div><div style="display:flex;gap:6px"><input class="Fi" id="cfginp-'+k+'" placeholder="Agregar..." style="flex:1" onkeydown="if(event.key===\'Enter\')cfgAdd(\''+k+'\')" ><button class="btn bg sm" onclick="cfgAdd(\''+k+'\')">+</button></div></div></div>'});
