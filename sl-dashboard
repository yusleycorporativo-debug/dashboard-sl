window.openAd=function(id){fillSelectors();var sel=$('ad-sid');if(sel)sel.innerHTML=(G('adsets')||[]).map(function(s){return'<option value="'+s.id+'">'+esc(s.n)+'</option>'}).join('');$('ad-id').value=id||'';
  if(id){var x=(G('ads')||[]).filter(function(z){return z.id===id})[0];if(x){$('ad-mt').textContent='Editar anuncio';$('ad-n').value=x.n;$('ad-sid').value=x.sid;$('ad-est').value=x.est;$('ad-cal').value=x.cal||'Promedio';$('ad-anio').value=x.anio||'2026';$('ad-mes').value=x.mes||'ENERO';$('ad-inv').value=x.inv||0;$('ad-imp').value=x.imp||0;$('ad-cli').value=x.cli||0;$('ad-res').value=x.res||0}}
  else{$('ad-mt').textContent='Nuevo anuncio';$('ad-n').value='';['ad-inv','ad-imp','ad-cli','ad-res'].forEach(function(i){$(i).value='0'})}
  $('ad-m').classList.add('on')};
window.saveAd=function(){var n=val('ad-n');if(!n){T('Escribe el nombre',true);return}var id=val('ad-id'),a=G('ads')||[],x;if(id)x=a.filter(function(z){return z.id===id})[0];if(!x){x={id:'a'+Date.now(),best:false};a.push(x)}
  x.n=n;x.sid=val('ad-sid');x.est=val('ad-est');x.cal=val('ad-cal');x.anio=val('ad-anio');x.mes=val('ad-mes');x.inv=num('ad-inv');x.imp=num('ad-imp');x.cli=num('ad-cli');x.res=num('ad-res');
  S('ads',a);LOG('ANUNCIO '+(id?'EDITADO':'CREADO'),n);closeMb('ad-m');rEstr();T('Anuncio guardado')};
