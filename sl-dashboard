window.rPlRes=function(){var acts=G('actividades')||[],pends=G('pendientes')||[];var stats=[{v:acts.length,l:'Actividades',c:'#0097e6'},{v:acts.filter(function(a){return a.est==='Listo'}).length,l:'Completadas',c:'#00c896'},{v:acts.filter(function(a){return a.est==='En proceso'}).length,l:'En proceso',c:'#0097e6'},{v:pends.filter(function(p){return p.est!=='Completado'}).length,l:'Pendientes',c:'#ffc43e'},{v:pends.filter(function(p){return p.pr==='Alta'&&p.est!=='Completado'}).length,l:'Alta prioridad',c:'#ff4757'}];set('pl-stats',stats.map(function(s){return'<div class="KC" style="text-align:center"><div class="KV" style="color:'+s.c+'">'+s.v+'</div><span class="KL">'+s.l+'</span></div>'}).join(''));var byCat={};acts.forEach(function(a){if(!byCat[a.cat])byCat[a.cat]=0;byCat[a.cat]++});set('pl-bycat',Object.entries(byCat).sort(function(a,b){return b[1]-a[1]}).map(function(e){return'<div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--b1)"><div style="flex:1;font-size:12px">'+e[0]+'</div><span class="pl pa">'+e[1]+'</span></div>'}).join('')||'<p style="color:var(--mu2);font-size:13px">Sin datos</p>');var byR={};acts.forEach(function(a){if(!byR[a.resp])byR[a.resp]=0;byR[a.resp]++});set('pl-byresp',Object.entries(byR).sort(function(a,b){return b[1]-a[1]}).map(function(e){return'<div style="display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--b1)"><div style="flex:1;font-size:12px;color:var(--pu)">'+e[0]+'</div><span class="pl pp">'+e[1]+'</span></div>'}).join('')||'<p style="color:var(--mu2);font-size:13px">Sin datos</p>')};

