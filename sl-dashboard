  trendLine('ch5',MES.map(function(mm){var iv=0,im=0;fcT.forEach(function(c){iv+=sum(c.inv,mm);im+=sum(c.imp,mm)});return im>0?iv/im*1000:0}),MES,'#a78bfa',function(v){return '$'+v.toFixed(0)});
  trendLine('ch6',MES.map(function(mm){var iv=0,re=0;fcT.forEach(function(c){iv+=sum(c.inv,mm);re+=sum(c.res,mm)});return re>0?iv/re:0}),MES,'#ffc43e',function(v){return '$'+v.toFixed(0)});
}

