/* ---------- BLOQUEO DE EDICIÓN (PIN) ---------- */
function root(){return document.getElementById('SLH')}
function canEdit(){var R=root();return!R||!R.classList.contains('locked')}
function setLock(on){var R=root();if(!R)return;R.classList.toggle('locked',on);var b=$('lkBtn'),ic=$('lkIco'),tx=$('lkTxt');if(b)b.classList.toggle('open',!on);if(ic)ic.innerHTML=on?'&#128274;':'&#128275;';if(tx)tx.textContent=on?'Bloqueado':'Edición ON'}
window.toggleLock=function(){
  var R=root();if(!R)return;
  if(R.classList.contains('locked')){
    var pin=G('pin');
    if(!pin){var np=prompt('Crea un PIN de edición (memorízalo, podrás cambiarlo borrando datos):');if(!np)return;S('pin',np);pin=np}
    var t=prompt('PIN de edición:');if(t===null)return;
    if(''+t===''+pin){setLock(false);LOG('EDICIÓN DESBLOQUEADA','');T('Edición activada')}else T('PIN incorrecto',true);
  }else{setLock(true);LOG('EDICIÓN BLOQUEADA','');T('Bloqueado')}
};
/* envolver mutaciones con guard */
['saveCp','delCp','saveAct','delAct','savePend','delPend','saveBud','delBud','saveObj','delObj','saveLog','clrLogs','cfgAdd','cfgDel','impJSON','clrAll','openCp','openSet','saveSet','delSet','bestSet','openAd','saveAd','delAd','bestAd'].forEach(function(nm){
  var o=window[nm];if(typeof o!=='function')return;
  window[nm]=function(){if(!canEdit()){T('Modo lectura: pulsa el candado e ingresa el PIN para editar',true);return}return o.apply(this,arguments)};
});

/* ---------- extras: candado, imprimir, anos ---------- */
function extras(){
  var R=root();setLock(false);
  var lb=$('lkBtn');if(lb&&!lb._b){lb._b=1;lb.addEventListener('click',toggleLock)}
  var pb=$('prnBtn');if(pb&&!pb._b){pb._b=1;pb.addEventListener('click',function(){window.print()})}
  var sb=$('syncBtn');if(sb&&!sb._b){sb._b=1;sb.addEventListener('click',function(){pullState()})}
  if(SYNC_URL){setInterval(function(){if(!_pushT&&!_loading&&!modalOpen())pullState()},3600000)}
  try{fillYearFilters()}catch(e){}
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',extras);else extras();

if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',boot);else boot();
})();
</script>
